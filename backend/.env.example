DEBUG=True
SECRET_KEY=replace-with-a-random-secret-key-of-at-least-32-characters
ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=mysql
DB_NAME=ultimate_dj_django
DB_USER=ultimate_dj_app
DB_PASSWORD=change-me-locally
DB_HOST=127.0.0.1
DB_PORT=3307

# Ancienne base XAMPP, utilisée uniquement par les commandes d'import.
LEGACY_DB_NAME=ultimate_dj
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
AUTH_LOGIN_RATE=10/minute
AUTH_ACCOUNT_ACTION_RATE=5/minute

# En production HTTPS : activer ces options et remplacer les domaines locaux.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_SUCCESS_URL=http://localhost:5173/?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/?payment=cancelled

# En local, les e-mails sont affichés dans le terminal Django.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Ultimate DJ <noreply@ultimate-dj.local>
