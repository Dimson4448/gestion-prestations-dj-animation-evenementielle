<mxfile host="app.diagrams.net" modified="2026-10-12T00:00:00.000Z" agent="Ultimate DJ" version="29.3.0" type="device">
  <diagram id="ultimate-dj-state-transition" name="Cycle de vie du dossier">
    <mxGraphModel dx="2200" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Diagramme d'état-transition — Cycle de vie d'un dossier de prestation&lt;/b&gt;" style="text;html=1;align=center;fontSize=25;fontColor=#0C1328;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1320" height="38" as="geometry"/></mxCell><mxCell id="subtitle" value="Fonctionnalité principale validée : traiter un devis, confirmer une réservation, préparer la prestation et encaisser le solde." style="text;html=1;align=center;fontSize=12;fontColor=#52647E;" vertex="1" parent="1"><mxGeometry x="300" y="58" width="1320" height="24" as="geometry"/></mxCell><mxCell id="draft" value="&lt;b&gt;Devis brouillon&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52647E&quot;&gt;statut du devis : brouillon&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontColor=#0C1328;fillColor=#F4FCFE;strokeColor=#00C8F5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="130" y="360" width="190" height="82" as="geometry"/></mxCell><mxCell id="waitingDj" value="&lt;b&gt;En attente de décision DJ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52647E&quot;&gt;statut du devis : envoyé&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontColor=#0C1328;fillColor=#FFF5FA;strokeColor=#FF2E91;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="360" width="220" height="82" as="geometry"/></mxCell><mxCell id="contractDeposit" value="&lt;b&gt;Contrat et acompte en attente&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52647E&quot;&gt;devis accepté&lt;br&gt;réservation créée&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontColor=#0C1328;fillColor=#FFFCF2;strokeColor=#F7B942;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="360" width="225" height="92" as="geometry"/></mxCell><mxCell id="confirmed" value="&lt;b&gt;Réservation confirmée&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52647E&quot;&gt;statut : confirmée&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontColor=#0C1328;fillColor=#F1FBF5;strokeColor=#20A16A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="975" y="360" width="205" height="82" as="geometry"/></mxCell><mxCell id="preparing" value="&lt;b&gt;Préparation de la prestation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52647E&quot;&gt;rendez-vous et playlist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontColor=#0C1328;fillColor=#F5F2FF;strokeColor=#7B61FF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="360" width="220" height="92" as="geometry"/></mxCell><mxCell id="performed" value="&lt;b&gt;Prestation clôturée&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52647E&quot;&gt;statut : réalisée&lt;br&gt;solde en attente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontColor=#0C1328;fillColor=#F5F2FF;strokeColor=#7B61FF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1540" y="360" width="220" height="92" as="geometry"/></mxCell><mxCell id="paid" value="&lt;b&gt;Dossier payé&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52647E&quot;&gt;statut : soldé&lt;br&gt;avis possible&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontColor=#0C1328;fillColor=#F1FBF5;strokeColor=#20A16A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1830" y="360" width="180" height="92" as="geometry"/></mxCell><mxCell id="refused" value="&lt;b&gt;Devis expiré ou abandonné&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontColor=#0C1328;fillColor=#FFF1F3;strokeColor=#E05A6D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="700" width="190" height="74" as="geometry"/></mxCell><mxCell id="cancelled" value="&lt;b&gt;Réservation annulée&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52647E&quot;&gt;créneau DJ libéré&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontColor=#0C1328;fillColor=#FFF1F3;strokeColor=#E05A6D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="700" width="210" height="74" as="geometry"/></mxCell><mxCell id="initial" value="" style="ellipse;fillColor=#0C1328;strokeColor=#0C1328;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="22" height="22" as="geometry"/></mxCell><mxCell id="finalPaidOuter" value="" style="ellipse;fillColor=none;strokeColor=#0C1328;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2070" y="386" width="30" height="30" as="geometry"/></mxCell><mxCell id="finalPaidInner" value="" style="ellipse;fillColor=#0C1328;strokeColor=#0C1328;" vertex="1" parent="1"><mxGeometry x="2078" y="394" width="14" height="14" as="geometry"/></mxCell><mxCell id="finalCancelledOuter" value="" style="ellipse;fillColor=none;strokeColor=#0C1328;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="722" width="30" height="30" as="geometry"/></mxCell><mxCell id="finalCancelledInner" value="" style="ellipse;fillColor=#0C1328;strokeColor=#0C1328;" vertex="1" parent="1"><mxGeometry x="1378" y="730" width="14" height="14" as="geometry"/></mxCell><mxCell id="t0" value="" style="rounded=0;endArrow=block;endFill=1;html=1;fontSize=12;fontColor=#27364F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="initial" target="draft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t1" value="" style="rounded=0;endArrow=block;endFill=1;html=1;fontSize=12;fontColor=#27364F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="draft" target